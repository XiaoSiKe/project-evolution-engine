+@pytest.mark.parametrize("kwargs", [{}, {"keepends": False}, {"keepends": True}])
+def test_iter_lines_keepends_incremental(kwargs):
+    closed: list[bool] = []
+
+    class Stream(httpx.SyncByteStream):
+        def __iter__(self) -> typing.Iterator[bytes]:
+            yield b"first\nsecond\r"
+            yield b""
+            yield b"\nthird\r"
+            yield b"last"
+
+        def close(self) -> None:
+            closed.append(True)
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.iter_lines(**kwargs)
+    assert not response.is_stream_consumed
+    assert not response.is_closed
+    assert next(lines) == "first\n".splitlines(**kwargs)[0]
+    assert response.is_stream_consumed
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r")
+    assert next(lines) == "second\r\n".splitlines(**kwargs)[0]
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r\nthird\r")
+    assert next(lines) == "third\r".splitlines(**kwargs)[0]
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r\nthird\rlast")
+    assert not response.is_closed
+    assert closed == []
+    assert next(lines) == "last"
+    assert response.is_closed
+    assert closed == [True]
+    assert list(lines) == []
+    response.close()
+    assert closed == [True]
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("kwargs", [{}, {"keepends": False}, {"keepends": True}])
+async def test_aiter_lines_keepends_incremental(kwargs):
+    closed: list[bool] = []
+
+    class Stream(httpx.AsyncByteStream):
+        async def __aiter__(self) -> typing.AsyncIterator[bytes]:
+            yield b"first\nsecond\r"
+            yield b""
+            yield b"\nthird\r"
+            yield b"last"
+
+        async def aclose(self) -> None:
+            closed.append(True)
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.aiter_lines(**kwargs)
+    assert not response.is_stream_consumed
+    assert not response.is_closed
+    assert await lines.__anext__() == "first\n".splitlines(**kwargs)[0]
+    assert response.is_stream_consumed
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r")
+    assert await lines.__anext__() == "second\r\n".splitlines(**kwargs)[0]
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r\nthird\r")
+    assert await lines.__anext__() == "third\r".splitlines(**kwargs)[0]
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r\nthird\rlast")
+    assert not response.is_closed
+    assert closed == []
+    assert await lines.__anext__() == "last"
+    assert response.is_closed
+    assert closed == [True]
+    assert [line async for line in lines] == []
+    await response.aclose()
+    assert closed == [True]
