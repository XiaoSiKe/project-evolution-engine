+@pytest.mark.parametrize("keepends", [False, True])
+@pytest.mark.parametrize(
+    "text",
+    ["", "tail", "\r", "\r\r\n", "\n\r", "\r\n\r", " \t\r\n \t"]
+    + [
+        f"{separator}a{separator}{separator}b{separator}tail"
+        for separator in (
+            "\n",
+            "\r",
+            "\r\n",
+            "\v",
+            "\f",
+            "\x1c",
+            "\x1d",
+            "\x1e",
+            "\x85",
+            "\u2028",
+            "\u2029",
+        )
+    ],
+)
+def test_line_decoder_splitlines(text, keepends):
+    expected = text.splitlines(keepends=keepends)
+    # Every three-chunk partition, including empty chunks between fragments.
+    for first in range(len(text) + 1):
+        for second in range(first, len(text) + 1):
+            chunks = (text[:first], "", text[first:second], "", text[second:], "")
+            decoder = LineDecoder(keepends=keepends)
+            lines = []
+            for chunk in chunks:
+                lines.extend(decoder.decode(chunk))
+            lines.extend(decoder.flush())
+            assert lines == expected, chunks
+            assert decoder.flush() == []
+
+
+@pytest.mark.parametrize("kwargs", [{}, {"keepends": False}, {"keepends": True}])
+def test_line_decoder_incremental(kwargs):
+    decoder = LineDecoder(**kwargs)
+    assert decoder.decode("") == []
+    assert decoder.decode("first\nsecond\r") == "first\n".splitlines(**kwargs)
+    assert decoder.decode("") == []
+    assert decoder.decode("\nthird\rlast") == "second\r\nthird\r".splitlines(**kwargs)
+    assert decoder.decode("\r") == []
+    assert decoder.decode("") == []
+    assert decoder.flush() == "last\r".splitlines(**kwargs)
+    assert decoder.flush() == []
+    assert decoder.decode("next\n") == "next\n".splitlines(**kwargs)
+    assert decoder.flush() == []
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("keepends", [False, True])
+@pytest.mark.parametrize("encoding", ["utf-8", "utf-16"])
+@pytest.mark.parametrize("content_encoding", ["identity", "gzip"])
+async def test_line_decoder_byte_boundaries(keepends, encoding, content_encoding):
+    text = "α\r\nβ\rγ\n\v\f\x1c\x1d\x1e\x85\u2028\u2029尾\r"
+    data = text.encode(encoding)
+    if content_encoding == "gzip":
+        compressor = zlib.compressobj(wbits=zlib.MAX_WBITS | 16)
+        data = compressor.compress(data) + compressor.flush()
+    headers = {
+        "Content-Type": f"text/plain; charset={encoding}",
+        "Content-Encoding": content_encoding,
+    }
+    expected = text.splitlines(keepends=keepends)
+
+    async def async_body(chunks: list[bytes]) -> typing.AsyncIterator[bytes]:
+        for chunk in chunks:
+            yield chunk
+
+    # Exercise every byte boundary through content, text, and line decoding.
+    for split in range(len(data) + 1):
+        chunks = [data[:split], b"", data[split:], b""]
+        response = httpx.Response(200, headers=headers, content=iter(chunks))
+        assert list(response.iter_lines(keepends=keepends)) == expected, split
+        response = httpx.Response(200, headers=headers, content=async_body(chunks))
+        lines = [line async for line in response.aiter_lines(keepends=keepends)]
+        assert lines == expected, split
+
+
