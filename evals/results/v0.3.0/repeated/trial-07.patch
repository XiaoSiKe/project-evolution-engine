+@pytest.mark.parametrize("kwargs", [{}, {"keepends": False}, {"keepends": True}])
+@pytest.mark.parametrize("buffering", ["preloaded", "read", "stream"])
+def test_iter_lines_keepends(line_content, kwargs, buffering):
+    def body() -> typing.Iterator[bytes]:
+        yield b""
+        for byte in line_content:
+            yield bytes([byte])
+            yield b""
+
+    response = httpx.Response(
+        200, content=line_content if buffering == "preloaded" else body()
+    )
+    if buffering == "read":
+        response.read()
+
+    text = line_content.decode("utf-8", errors="replace")
+    assert list(response.iter_lines(**kwargs)) == text.splitlines(**kwargs)
+    assert response.is_stream_consumed
+    assert response.is_closed
+
+    if buffering == "stream":
+        with pytest.raises(httpx.ResponseNotRead):
+            _ = response.content
+        with pytest.raises(httpx.StreamConsumed):
+            list(response.iter_lines(**kwargs))
+    else:
+        assert response.content == line_content
+        assert "".join(response.iter_text()) == text
+        assert list(response.iter_lines()) == text.splitlines()
+        assert list(response.iter_lines(True)) == text.splitlines(keepends=True)
