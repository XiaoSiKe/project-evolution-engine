+        params["_null"] = null
+    if stream:
+        params["_stream"] = "1"
+    if not header:
+        params["_header"] = "off"
+    if custom_sql:
+        path = "/csv_null/-/query.csv"
+        params["sql"] = (
+            "select id, nullable, empty, zero, text from records order by id limit 3"
+        )
+        expected_ids = range(1, 4)
+    else:
+        path = "/csv_null/records.csv"
+        params["_nocol"] = "label_id"
+        expected_ids = range(1, 8 if stream else 3)
+
+    response = await csv_null_ds.client.get(path, params=params)
+    assert response.status_code == 200
+    assert response.headers["content-type"] == "text/plain; charset=utf-8"
