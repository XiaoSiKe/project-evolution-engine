+        await db.execute_write_script("""
+            create table labels (id integer primary key, name);
+            insert into labels values (0, ''), (1, 'hello'), (2, null), (3, 0);
+            create table records (
+                id integer primary key,
+                nullable,
+                empty text,
+                zero integer,
+                text text,
+                label_id integer references labels(id)
+            );
+            insert into records values
+                (1, null, '', 0, 'ordinary', null),
+                (2, null, '', 0, 'ordinary', 0),
+                (3, null, '', 0, 'ordinary', 1),
+                (4, null, '', 0, 'ordinary', 2),
+                (5, null, '', 0, 'ordinary', 3),
