+    assert list(csv.reader(io.StringIO(response.text, newline=""))) == expected
+    output = io.StringIO(newline="")
+    csv.writer(output).writerows(expected)
+    assert response.text == output.getvalue()
+    if null == "":
+        del params["_null"]
+        original = await csv_null_ds.client.get(path, params=params)
+        assert response.content == original.content
