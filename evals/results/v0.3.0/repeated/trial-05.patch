+def test_iter_lines_keepends_cached(line_body, line_options):
+    response = httpx.Response(200, content=line_body)
+    text = line_body.decode("utf-8", errors="replace")
+
+    assert list(response.iter_lines(**line_options)) == text.splitlines(**line_options)
+    assert list(response.iter_lines()) == text.splitlines()
+    assert "".join(response.iter_text()) == response.text == text
+    assert b"".join(response.iter_bytes()) == response.content == line_body
+
+
+@pytest.mark.anyio
+async def test_aiter_lines_keepends_cached(line_body, line_options):
+    response = httpx.Response(200, content=line_body)
