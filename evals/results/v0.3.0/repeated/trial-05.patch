+@pytest.mark.parametrize("finish", [False, True])
+def test_iter_lines_keepends_incremental(line_options, finish):
+    chunks = [b"first\n", b"second\r", b"", b"\n", b"last\r"]
+    reads: typing.List[bytes] = []
+    closes: typing.List[bool] = []
+
+    class Stream(httpx.SyncByteStream):
+        def __iter__(self):
+            for chunk in chunks:
+                if closes:
+                    return
+                reads.append(chunk)
+                yield chunk
+
+        def close(self):
+            closes.append(True)
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.iter_lines(**line_options)
+    assert reads == []
+    assert not response.is_stream_consumed
+    assert next(lines) == "first\n".splitlines(**line_options)[0]
+    assert reads == chunks[:1]
+    assert response.is_stream_consumed
+    assert next(lines) == "second\r\n".splitlines(**line_options)[0]
+    assert reads == chunks[:4]
+    assert not response.is_closed
+    assert closes == []
+
+    if finish:
+        assert list(lines) == "last\r".splitlines(**line_options)
+        assert reads == chunks
+        assert response.is_closed
+        assert closes == [True]
+    response.close()
+    assert response.is_closed
+    assert closes == [True]
+    assert list(lines) == []
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("finish", [False, True])
+async def test_aiter_lines_keepends_incremental(line_options, finish):
+    chunks = [b"first\n", b"second\r", b"", b"\n", b"last\r"]
+    reads: typing.List[bytes] = []
+    closes: typing.List[bool] = []
+
+    class Stream(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            for chunk in chunks:
+                if closes:
+                    return
+                reads.append(chunk)
+                yield chunk
+
+        async def aclose(self):
+            closes.append(True)
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.aiter_lines(**line_options)
+    assert reads == []
+    assert not response.is_stream_consumed
+    assert await lines.__anext__() == "first\n".splitlines(**line_options)[0]
+    assert reads == chunks[:1]
+    assert response.is_stream_consumed
+    assert await lines.__anext__() == "second\r\n".splitlines(**line_options)[0]
+    assert reads == chunks[:4]
+    assert not response.is_closed
+    assert closes == []
+
+    if finish:
+        assert [line async for line in lines] == "last\r".splitlines(**line_options)
+        assert reads == chunks
+        assert response.is_closed
+        assert closes == [True]
+    await response.aclose()
+    assert response.is_closed
+    assert closes == [True]
+    # Finish unwinding the iterators after the test stream has closed.
+    assert [line async for line in lines] == []
