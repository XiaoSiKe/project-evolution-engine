+def line_chunkings(body):
+    # Include every byte boundary, then split every byte with empty chunks.
+    for split in range(len(body) + 1):
+        yield [b"", body[:split], b"", body[split:], b""]
+    yield [chunk for i in range(len(body)) for chunk in (body[i : i + 1], b"")]
+
