+@pytest.mark.parametrize("keepends", [False, True])
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "abc",
+        "\r",
+        "\n",
+        "\r\n",
+        "\r\r\n",
+        "\r\n\r",
+        "a\r\nb\r",
+        "a\n\nb",
+        "雪\r\n☃",
+        "a\x1fb",
+        "\n\r\v\f\x1c\x1d\x1e\x85\u2028\u2029",
+    ],
+)
+def test_line_decoder_keepends(text, keepends):
+    # Exercise every partition of the text, with empty chunks between parts.
+    for breaks in itertools.product((False, True), repeat=max(0, len(text) - 1)):
+        positions = [0]
+        positions.extend(i for i, split in enumerate(breaks, start=1) if split)
+        positions.append(len(text))
+        decoder = LineDecoder(keepends=keepends)
+        lines = []
+        for start, end in zip(positions, positions[1:]):
+            lines.extend(decoder.decode(""))
+            lines.extend(decoder.decode(text[start:end]))
+        lines.extend(decoder.decode(""))
+        lines.extend(decoder.flush())
+        assert lines == text.splitlines(keepends=keepends), positions
+        assert decoder.flush() == []
+
+
+@pytest.mark.parametrize("keepends", [False, True])
+def test_line_decoder_keepends_incremental(keepends):
+    decoder = LineDecoder(keepends=keepends)
+    assert decoder.decode("one\npart") == ["one\n" if keepends else "one"]
+    assert decoder.decode("ial\r") == []
+    assert decoder.decode("") == []
+    assert decoder.decode("\nlast\r") == ["partial\r\n" if keepends else "partial"]
+    assert decoder.flush() == ["last\r" if keepends else "last"]
+    assert decoder.flush() == []
+    assert decoder.decode("again\n") == ["again\n" if keepends else "again"]
+    assert decoder.flush() == []
+
