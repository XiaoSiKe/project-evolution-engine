+
+    lines = [line async for line in response.aiter_lines(**line_options)]
+    assert lines == text.splitlines(**line_options)
+    assert [line async for line in response.aiter_lines()] == text.splitlines()
+    assert "".join([part async for part in response.aiter_text()]) == response.text == text
+    assert b"".join([part async for part in response.aiter_bytes()]) == line_body
+    assert response.content == line_body
