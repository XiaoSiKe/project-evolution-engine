+@pytest.mark.asyncio
+@pytest.mark.parametrize("query", [False, True], ids=["table", "query"])
+async def test_csv_null_trace_and_download(null_csv_ds, query):
+    marker = '</textarea><script>alert("空")</script>&\nnext'
+    path = "/csv_null/records.csv"
+    params = {"_null": marker, "_dl": "1"}
+    filename = "records.csv"
+    if query:
+        path = "/csv_null/-/query.csv"
+        params["sql"] = "select * from records order by id"
+        filename = "csv_null.csv"
+    download = await null_csv_ds.client.get(path, params=params)
+    assert download.status_code == 200
+    assert download.headers["content-type"] == "text/csv; charset=utf-8"
+    assert (
+        download.headers["content-disposition"]
+        == f'attachment; filename="{filename}"'
+    )
+    response = await null_csv_ds.client.get(path, params={**params, "_trace": "1"})
+    assert response.status_code == 200
+    assert response.headers["content-type"] == "text/html; charset=utf-8"
+    assert (
+        response.headers["content-disposition"]
+        == download.headers["content-disposition"]
+    )
+    soup = Soup(response.text, "html.parser")
+    assert len(soup.find_all("textarea")) == 1
+    assert not soup.find_all("script")
+    assert "&lt;/textarea&gt;&lt;script&gt;" in response.text
+    assert soup.find("textarea").text == download.text
+    assert list(csv.reader(io.StringIO(soup.find("textarea").text)))[1] == [
+        "1",
+        marker,
+        marker,
+    ]
