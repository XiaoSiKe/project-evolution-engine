+@pytest.mark.parametrize("labels", [False, True])
+async def test_csv_blob_primary_keys(null_csv_ds, primary_keys, labels):
+    db = null_csv_ds.get_database("csv_null")
+    await db.execute_write_script(f"""
+        create table downloads (
+            label_id integer references labels(id),
+            content blob,
+            key text,
+            version integer,
+            optional blob,
+            primary key ({primary_keys})
+        );
+        insert into downloads values
+            (0, x'00ff', 'a/b,雪', 0, null),
+            (1, x'', 'second', 2, null),
+            (null, null, 'third', 3, null);
+    """)
+    response = await null_csv_ds.client.get(
+        "/csv_null/downloads.csv",
+        params={
+            "_null": "NULL",
+            "_stream": "1",
+            "_size": "1",
+            "_labels": "1" if labels else "0",
+        },
+    )
+    assert response.status_code == 200
+    rows = list(csv.DictReader(io.StringIO(response.text)))
+    assert len(rows) == 3
+    assert [row["key"] for row in rows] == ["a/b,雪", "second", "third"]
+    assert [row["optional"] for row in rows] == ["NULL"] * 3
+    assert [row["label_id"] for row in rows] == ["0", "1", "NULL"]
+    if labels:
+        assert [row["label_id_label"] for row in rows] == ["0", "", "NULL"]
+    assert rows[2]["content"] == "NULL"
+    for row, expected_bytes in zip(rows[:2], [b"\x00\xff", b""]):
+        url = row["content"]
+        assert url.startswith("http://localhost/csv_null/downloads/")
+        assert urllib.parse.parse_qs(urllib.parse.urlsplit(url).query) == {
+            "_blob_column": ["content"]
+        }
+        blob_response = await null_csv_ds.client.get(url.removeprefix("http://localhost"))
+        assert blob_response.status_code == 200
+        assert blob_response.content == expected_bytes
+        assert blob_response.headers["content-type"] == "application/binary"
+
