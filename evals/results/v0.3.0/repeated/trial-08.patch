+@pytest.mark.asyncio
+@pytest.mark.parametrize("query", [False, True], ids=["table", "query"])
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("header", ["on", "off"])
+@pytest.mark.parametrize("null", [None, "", "NULL", "0", '缺失,"空"\n下一行\r末行'])
+async def test_csv_null(null_csv_ds, query, stream, header, null):
+    params = {"_size": "max", "_header": header}
+    path = "/csv_null/records.csv"
+    if query:
+        path = "/csv_null/-/query.csv"
+        params["sql"] = "select * from records order by id"
+    if stream:
+        params["_stream"] = "1"
+    if null is not None:
+        params["_null"] = null
+    response = await null_csv_ds.client.get(path, params=params)
+    assert response.status_code == 200
+    assert response.headers["content-type"] == "text/plain; charset=utf-8"
+    assert response.headers["access-control-allow-origin"] == "*"
+    marker = "" if null is None else null
+    expected = [
+        ["1", marker, marker],
+        ["2", "", "1"],
+        ["3", "0", "0"],
+        ["4", "text", "2"],
+        ["5", marker, "3"],
+        ["6", marker, "99"],
+        ["7", "last", marker],
+    ]
+    if query or not stream:
+        # Custom SQL retains its result limit; table streaming follows every page.
+        expected = expected[:3]
+    if header != "off":
+        expected.insert(0, ["id", "value", "label_id"])
+    assert list(csv.reader(io.StringIO(response.text))) == expected
+    if null == "":
+        params.pop("_null")
+        default_response = await null_csv_ds.client.get(path, params=params)
+        assert response.content == default_response.content
+
+
