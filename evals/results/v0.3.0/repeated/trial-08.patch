+@pytest_asyncio.fixture
+async def null_csv_ds(request):
+    options = getattr(request, "param", {})
+    ds = Datasette(
+        cors=True,
+        config=options.get("config"),
+        settings={
+            "default_page_size": 2,
+            "max_returned_rows": 3,
+            "max_csv_mb": 1,
+            "trace_debug": True,
+            **options.get("settings", {}),
+        },
+    )
+    try:
+        await ds.invoke_startup()
+        db = ds.add_memory_database(f"csv_null_{secrets.token_hex(8)}", name="csv_null")
+        await db.execute_write_script("""
+            create table labels (id integer primary key, label);
+            insert into labels values (0, 0), (1, ''), (2, 'label'), (3, null);
+            create table records (
+                id integer primary key,
+                value,
+                label_id integer references labels(id)
+            );
+            insert into records values
+                (1, null, null), (2, '', 1), (3, 0, 0), (4, 'text', 2),
+                (5, null, 3), (6, null, 99), (7, 'last', null);
+        """)
+        yield ds
+    finally:
+        ds.close()
+
