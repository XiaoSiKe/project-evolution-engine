+def test_line_decoder_keepends_chunk_boundaries(text, keepends):
+    expected = text.splitlines(keepends=keepends)
+    # Every partition into three chunks, including empty chunks between them.
+    for first in range(len(text) + 1):
+        for second in range(first, len(text) + 1):
+            chunks = [text[:first], "", text[first:second], "", text[second:], ""]
+            decoder = LineDecoder(keepends=keepends)
+            lines = [line for chunk in chunks for line in decoder.decode(chunk)]
+            assert lines + decoder.flush() == expected, chunks
+            assert decoder.flush() == []
+
+
+@pytest.mark.parametrize("keepends", [False, True])
+def test_line_decoder_keepends_incremental(keepends):
+    decoder = LineDecoder(keepends=keepends)
+    assert decoder.decode("") == []
+    assert decoder.decode("first\npar") == "first\n".splitlines(keepends)
+    assert decoder.decode("tial\r") == []
+    assert decoder.decode("") == []
+    assert decoder.decode("\n\nthird\r") == "partial\r\n\n".splitlines(keepends)
+    assert decoder.decode("last") == "third\r".splitlines(keepends)
+    assert decoder.flush() == ["last"]
+    assert decoder.flush() == []
+
+    # Flushing a final CR must preserve it only when requested, then reset state.
+    assert decoder.decode("\r") == []
+    assert decoder.decode("") == []
+    assert decoder.flush() == "\r".splitlines(keepends)
+    assert decoder.flush() == []
+
