+def line_chunkings(content):
+    yield [content]
+    yield [content[index : index + 1] for index in range(len(content))]
+    # Split at every byte boundary, including within UTF-8 characters and CRLF.
+    for index in range(len(content) + 1):
+        yield [b"", content[:index], b"", content[index:], b""]
+
