+@pytest.mark.parametrize("finish", [False, True])
+def test_iter_lines_keepends_incremental(line_options, finish):
+    closed = []
+
+    class Stream(httpx.SyncByteStream):
+        def __iter__(self):
+            yield b"first\n"
+            yield b"second\r"
+            yield b""
+            yield b"\nthird\r"
+            yield b"last"
