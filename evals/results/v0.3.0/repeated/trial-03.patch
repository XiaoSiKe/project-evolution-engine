+@pytest.mark.anyio
+@pytest.mark.parametrize("finish", [False, True])
+async def test_aiter_lines_keepends_incremental(line_options, finish):
+    closed = []
+
+    class Stream(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            for chunk in [b"first\n", b"second\r", b"", b"\nthird\r", b"last"]:
+                if closed:
+                    return
+                yield chunk
+
+        async def aclose(self):
+            closed.append(True)
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.aiter_lines(**line_options)
+    assert not response.is_stream_consumed
+    assert await lines.__anext__() == "first\n".splitlines(**line_options)[0]
+    assert response.num_bytes_downloaded == len(b"first\n")
+    assert await lines.__anext__() == "second\r\n".splitlines(**line_options)[0]
+    assert response.num_bytes_downloaded == len(b"first\nsecond\r\nthird\r")
+    assert response.is_stream_consumed
+    assert not response.is_closed
+    assert closed == []
+
+    if finish:
+        remaining = [line async for line in lines]
+        assert remaining == "third\rlast".splitlines(**line_options)
+        assert response.is_closed
+        assert closed == [True]
+
+    await response.aclose()
+    assert response.is_closed
+    assert closed == [True]
+
+    # Finish the iterator over the closed test stream, including buffered text,
+    # so no async generators are left for Trio's garbage collector to clean up.
+    async for _ in lines:
