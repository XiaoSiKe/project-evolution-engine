+@pytest.mark.anyio
+async def test_cached_iter_lines_keepends(line_content, line_options):
+    response = httpx.Response(200, content=line_content)
+    text = line_content.decode("utf-8", errors="replace")
+    expected = text.splitlines(**line_options)
+
+    assert list(response.iter_lines(**line_options)) == expected
+    assert [line async for line in response.aiter_lines(**line_options)] == expected
+    # Line iteration must not change cached content or the other text interfaces.
+    assert response.content == line_content
+    assert response.text == text
+    assert "".join(response.iter_text()) == text
+    assert "".join([part async for part in response.aiter_text()]) == text
+    assert list(response.iter_lines(**line_options)) == expected
+
+
+@pytest.mark.parametrize("preload", [False, True])
+def test_iter_lines_keepends_streaming(line_content, line_options, preload):
+    expected = line_content.decode("utf-8", errors="replace").splitlines(**line_options)
+    for chunks in line_chunkings(line_content):
+        response = httpx.Response(200, content=iter(chunks))
+        if preload:
+            response.read()
+
+        assert list(response.iter_lines(**line_options)) == expected, chunks
+        assert response.is_closed
+        assert response.is_stream_consumed
