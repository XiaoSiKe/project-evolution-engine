+async def test_line_decoder_keepends_content_encoding(keepends, encoding):
+    text = "café\r\n\r\nolé\rlast\x85end"
+    compressor = zlib.compressobj(wbits=zlib.MAX_WBITS | 16)
+    compressed = compressor.compress(text.encode(encoding)) + compressor.flush()
+    chunks = [compressed[index : index + 1] for index in range(len(compressed))]
+    headers = {
