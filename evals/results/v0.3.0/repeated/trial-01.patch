+@pytest.mark.parametrize("keepends", [False, True])
+@pytest.mark.parametrize(
+    "newline",
+    [
+        "\r\n",
+        "\r",
+        "\n",
+        "\v",
+        "\f",
+        "\x1c",
+        "\x1d",
+        "\x1e",
+        "\x85",
+        "\u2028",
+        "\u2029",
+    ],
+)
+def test_line_decoder_keepends(keepends, newline):
+    text = f"{newline}Hello{newline}{newline}world{newline}last{newline}"
+    for split in range(len(text) + 1):
+        decoder = LineDecoder(keepends=keepends)
+        lines = decoder.decode(text[:split])
+        lines += decoder.decode("")
+        lines += decoder.decode(text[split:])
+        lines += decoder.flush()
+        assert lines == text.splitlines(keepends=keepends)
+        assert decoder.flush() == []
+
+
+@pytest.mark.parametrize("keepends", [False, True])
+def test_line_decoder_incremental(keepends):
+    decoder = LineDecoder(keepends=keepends)
+    assert decoder.decode("") == []
+    assert decoder.flush() == []
+    assert decoder.decode("hel") == []
+    assert decoder.decode("lo\r") == []
+    assert decoder.decode("") == []
+    assert decoder.decode("\nworld\nlast\r") == (
+        ["hello\r\n", "world\n"] if keepends else ["hello", "world"]
+    )
+    assert decoder.decode("") == []
+    assert decoder.flush() == (["last\r"] if keepends else ["last"])
+    assert decoder.flush() == []
+
+    # Flushing resets both the partial line and the pending CR.
+    assert decoder.decode("tail") == []
+    assert decoder.flush() == ["tail"]
+    assert decoder.decode("\r") == []
+    assert decoder.decode("") == []
+    assert decoder.flush() == (["\r"] if keepends else [""])
+    assert decoder.flush() == []
+
