+@pytest.fixture(
+    params=[
+        [],
+        [b""],
+        [b"", b"Hello,\n", b"world!", b""],
+        [b"\r"],
+        [b"\r", b"\r"],
+        [b"\n", b"\r", b"\n", b"\r"],
+        [b"one\r", b"", b"\n\r", b"", b"two\r", b"\nlast\r", b""],
+        [
+            bytes([byte])
+            for byte in "\n中\r\n\r🌍\v\f\x1c\x1d\x1e\x85\u2028\u2029last".encode()
+        ],
+        [b"\xe4", b"\xb8", b"\xad\r", b"", b"\n", b"\xe2", b"\x80"],
+    ],
+    ids=[
+        "empty-stream",
+        "empty-chunk",
+        "unterminated",
+        "bare-cr",
+        "consecutive-cr",
+        "blank-lines",
+        "split-crlf",
+        "unicode-byte-chunks",
+        "incomplete-utf8",
+    ],
+)
+def line_chunks(request):
+    return request.param
+
+
+@pytest.mark.parametrize("mode", ["cached", "read", "stream"])
+@pytest.mark.parametrize(
+    "kwargs",
+    [{}, {"keepends": False}, {"keepends": True}],
+    ids=["default", "strip", "keep"],
+)
+def test_iter_lines_keepends(line_chunks, mode, kwargs):
+    body = b"".join(line_chunks)
+    text = body.decode("utf-8", errors="replace")
+    expected = text.splitlines(**kwargs)
+    response = httpx.Response(
+        200,
+        content=body if mode == "cached" else iter(line_chunks),
+    )
+    if mode == "read":
+        response.read()
+
+    assert list(response.iter_lines(**kwargs)) == expected
+    assert response.is_stream_consumed
+    assert response.is_closed
+    if mode != "stream":
+        assert response.content == body
+        assert "".join(response.iter_text()) == text
+        assert list(response.iter_lines(**kwargs)) == expected
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("mode", ["cached", "read", "stream"])
+@pytest.mark.parametrize(
+    "kwargs",
+    [{}, {"keepends": False}, {"keepends": True}],
+    ids=["default", "strip", "keep"],
+)
+async def test_aiter_lines_keepends(line_chunks, mode, kwargs):
+    async def stream():
+        for chunk in line_chunks:
+            yield chunk
+
+    body = b"".join(line_chunks)
+    text = body.decode("utf-8", errors="replace")
+    expected = text.splitlines(**kwargs)
+    response = httpx.Response(200, content=body if mode == "cached" else stream())
+    if mode == "read":
+        await response.aread()
+
+    assert [line async for line in response.aiter_lines(**kwargs)] == expected
+    assert response.is_stream_consumed
+    assert response.is_closed
+    if mode != "stream":
+        assert response.content == body
+        assert "".join([part async for part in response.aiter_text()]) == text
+        assert [line async for line in response.aiter_lines(**kwargs)] == expected
+
+
+@pytest.mark.parametrize("keepends", [False, True])
+def test_iter_lines_incremental(keepends):
+    chunks = [b"first\n", b"second\r", b"", b"\n", b"last"]
+    received: list[bytes] = []
+    close_calls = 0
+
+    class Stream(httpx.SyncByteStream):
+        def __iter__(self):
+            for chunk in chunks:
+                received.append(chunk)
+                yield chunk
+
+        def close(self):
+            nonlocal close_calls
+            close_calls += 1
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.iter_lines(keepends)
+    assert received == []
+    assert not response.is_stream_consumed
+    assert next(lines) == ("first\n" if keepends else "first")
+    assert received == chunks[:1]
+    assert response.is_stream_consumed
+    assert not response.is_closed
+    assert close_calls == 0
+    assert next(lines) == ("second\r\n" if keepends else "second")
+    assert received == chunks[:4]
+    assert not response.is_closed
+    assert next(lines) == "last"
+    assert received == chunks
+    assert list(lines) == []
+    assert response.is_closed
+    assert close_calls == 1
+    with pytest.raises(httpx.StreamConsumed):
+        list(response.iter_lines(keepends=keepends))
+    with pytest.raises(httpx.ResponseNotRead):
+        response.content  # noqa: B018
+    response.close()
+    assert close_calls == 1
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("keepends", [False, True])
+async def test_aiter_lines_incremental(keepends):
+    chunks = [b"first\n", b"second\r", b"", b"\n", b"last"]
+    received: list[bytes] = []
+    close_calls = 0
+
+    class Stream(httpx.AsyncByteStream):
+        async def __aiter__(self):
+            for chunk in chunks:
+                received.append(chunk)
+                yield chunk
+
+        async def aclose(self):
+            nonlocal close_calls
+            close_calls += 1
+
+    response = httpx.Response(200, stream=Stream())
+    lines = response.aiter_lines(keepends)
+    assert received == []
+    assert not response.is_stream_consumed
+    assert await lines.__anext__() == ("first\n" if keepends else "first")
+    assert received == chunks[:1]
+    assert response.is_stream_consumed
+    assert not response.is_closed
+    assert close_calls == 0
+    assert await lines.__anext__() == ("second\r\n" if keepends else "second")
+    assert received == chunks[:4]
+    assert not response.is_closed
+    assert await lines.__anext__() == "last"
+    assert received == chunks
+    assert [line async for line in lines] == []
+    assert response.is_closed
+    assert close_calls == 1
+    with pytest.raises(httpx.StreamConsumed):
+        [line async for line in response.aiter_lines(keepends=keepends)]
+    with pytest.raises(httpx.ResponseNotRead):
+        response.content  # noqa: B018
+    await response.aclose()
+    assert close_calls == 1
+
