+++ b/tests/test_pricing.py
@@ -0,0 +1,22 @@
+import unittest
+
+from app.domain.pricing import amount
+from app.pricing import amount as legacy_amount
+
+
+class PricingTest(unittest.TestCase):
+    def test_default_amount(self):
+        self.assertEqual(amount(200), 200)
+
+    def test_non_member_amount(self):
+        self.assertEqual(amount(200, member=False), 200)
+
+    def test_member_amount(self):
+        for subtotal, expected in ((200, 180), (12.5, 11.25), (0, 0)):
+            with self.subTest(subtotal=subtotal):
+                self.assertEqual(amount(subtotal, member=True), expected)
+
+
+class LegacyPricingTest(unittest.TestCase):
+    def test_legacy_importer_amount(self):
+        self.assertEqual(legacy_amount(200), 200)
