+import json
+from pathlib import Path
 import unittest
 from app.statuses import VALID_STATUSES
 class StatusTest(unittest.TestCase):
     def test_existing(self):
         self.assertEqual(VALID_STATUSES[:3],("queued","running","done"))
 
+    def test_cancelled_appended(self):
+        self.assertEqual(VALID_STATUSES, ("queued", "running", "done", "cancelled"))
+
+    def test_generated_artifacts_match_schema(self):
+        root = Path(__file__).resolve().parents[1]
+        states = json.loads((root / "schema/statuses.json").read_text())
+        self.assertEqual(VALID_STATUSES, tuple(states))
+        documented_states = [
+            line[2:]
+            for line in (root / "docs/statuses.md").read_text().splitlines()
+            if line.startswith("- ")
+        ]
+        self.assertEqual(documented_states, states)
