--- a/README.md
+++ b/README.md
@@ -2,3 +2,29 @@
 
 app.exporter.export_one(record, actor) exports one record.
 Policy and formatting are owned by app.policy.
+
+`app.exporter.export_many(records, actor)` returns a list of strings in input
+order, using the same authorization and formatting as `export_one`.
+An empty input returns `[]`. The record owner and `admin` may export a record;
+an unauthorized record raises `PermissionError("not your record")` in both APIs.
+Batch export stops at the first rejected record and does not return a partial list.
+The existing `export_one(record, actor)` call remains supported.
+
+```python
+from app.exporter import export_many, export_one
+
+records = [
+    {"id": 2, "owner": "lin", "amount": 12},
+    {"id": 1, "owner": "lin", "amount": 9.5},
+]
+
+assert export_one(records[0], "lin") == "2:CNY 12.00"
+assert export_many(records, "lin") == ["2:CNY 12.00", "1:CNY 9.50"]
+assert export_many([], "lin") == []
+```
+
+Run the tests from the project root:
+
+```sh
+python3 -B -m unittest discover -s tests -v
+```
--- a/app/exporter.py
+++ b/app/exporter.py
@@ -2,3 +2,8 @@
 def export_one(record, actor):
     policy.authorize(record, actor)
     return policy.render(record)
+
+
+def export_many(records, actor):
+    """Export records in input order using the single-record policy."""
+    return [export_one(record, actor) for record in records]
