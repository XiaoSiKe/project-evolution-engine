+
+class BatchExportTest(unittest.TestCase):
+    def test_owner_preserves_order_and_format(self):
+        records = [
+            {"id": 3, "owner": "lin", "amount": 12},
+            {"id": 1, "owner": "lin", "amount": 2.345},
+            {"id": 3, "owner": "lin", "amount": 0},
+        ]
+        self.assertEqual(
+            export_many(records, "lin"),
+            ["3:CNY 12.00", "1:CNY 2.35", "3:CNY 0.00"],
+        )
+
+    def test_admin_can_export_records_from_different_owners(self):
+        records = [
+            {"id": 1, "owner": "lin", "amount": 12},
+            {"id": 2, "owner": "mei", "amount": 9.5},
+        ]
+        self.assertEqual(
+            export_many(records, "admin"),
+            ["1:CNY 12.00", "2:CNY 9.50"],
+        )
+        self.assertEqual(export_one(records[1], "admin"), "2:CNY 9.50")
+
+    def test_empty_input_returns_empty_list(self):
+        self.assertEqual(export_many([], "other"), [])
+
+    def test_denied_record_raises_single_export_exception(self):
+        allowed = {"id": 1, "owner": "lin", "amount": 12}
+        denied = {"id": 2, "owner": "mei", "amount": 9.5}
+        with self.assertRaises(PermissionError) as single_error:
+            export_one(denied, "lin")
+        for records in ([denied], [allowed, denied]):
+            with self.subTest(records=records):
+                with self.assertRaises(type(single_error.exception)) as batch_error:
+                    export_many(records, "lin")
+                self.assertEqual(batch_error.exception.args, single_error.exception.args)
+
+    def test_formatting_follows_canonical_policy(self):
+        record = {"id": 1, "owner": "lin", "amount": 12}
+        with patch("app.policy.CURRENCY", "USD"):
+            self.assertEqual(export_one(record, "lin"), "1:USD 12.00")
+            self.assertEqual(export_many([record], "lin"), ["1:USD 12.00"])
+
+    def test_updated_authorization_is_shared_by_both_interfaces(self):
+        record = {"id": 1, "owner": "lin", "amount": 12}
+        with patch("app.policy.authorize", side_effect=PermissionError("exports disabled")):
+            with self.assertRaisesRegex(PermissionError, "^exports disabled$"):
+                export_one(record, "admin")
+            with self.assertRaisesRegex(PermissionError, "^exports disabled$"):
+                export_many([record], "admin")
