+    /**
+     * Removes one completed batch, retaining only its records and the original
+     * ID order for a single undo. An empty clear leaves the previous batch intact.
+     */
+    Store.prototype.removeCompleted = function (callback) {
+        callback = callback || function () {};
+        var data = JSON.parse(MemoryStorage[this._dbName]);
+        var completed = data.todos.filter(function (todo) {
+            return todo.completed === true;
+        });
+
+        if (completed.length > 0) {
+            ClearCompletedHistory[this._dbName] = {
+                todos: completed,
+                order: data.todos.map(function (todo) { return todo.id; }),
+            };
+            data.todos = data.todos.filter(function (todo) {
+                return todo.completed !== true;
+            });
+            MemoryStorage[this._dbName] = JSON.stringify(data);
+        }
+
+        callback.call(this, data.todos);
+    };
+
+    Store.prototype.canUndoClearCompleted = function () {
+        return !!ClearCompletedHistory[this._dbName];
+    };
+
+    /**
+     * Merges a cleared batch into the current list without rolling back later
+     * edits or separate deletions. New tasks remain after the original tasks.
+     */
+    Store.prototype.undoClearCompleted = function (callback) {
+        callback = callback || function () {};
+        var data = JSON.parse(MemoryStorage[this._dbName]);
+        var history = ClearCompletedHistory[this._dbName];
+
+        if (history) {
+            var byId = Object.create(null);
+            var restored = [];
+            data.todos.forEach(function (todo) {
+                byId[todo.id] = todo;
+            });
+            history.todos.forEach(function (todo) {
+                if (!byId[todo.id])
+                    byId[todo.id] = todo;
+            });
+
+            // Missing original survivors were deleted separately: skip them.
+            history.order.forEach(function (id) {
+                if (byId[id]) {
+                    restored.push(byId[id]);
+                    delete byId[id];
+                }
+            });
+            data.todos.forEach(function (todo) {
+                if (byId[todo.id])
+                    restored.push(todo);
+            });
+
+            data.todos = restored;
+            MemoryStorage[this._dbName] = JSON.stringify(data);
+            delete ClearCompletedHistory[this._dbName];
+        }
+
+        callback.call(this, data.todos);
+    };
+
     /**
      * Will drop all storage and start fresh
      *
@@ -137,6 +207,7 @@
     Store.prototype.drop = function (callback) {
         var data = { todos: [] };
         MemoryStorage[this._dbName] = JSON.stringify(data);
+        delete ClearCompletedHistory[this._dbName];
