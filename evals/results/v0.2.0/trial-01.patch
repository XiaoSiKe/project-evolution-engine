diff --git a/test/todo.test.js b/test/todo.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5d259521295ffda60dae3449c431aab96f085580
--- /dev/null
+++ b/test/todo.test.js
@@ -0,0 +1,262 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const { JSDOM } = require("jsdom");
+
+const root = path.resolve(__dirname, "..", process.env.TODO_APP_ROOT || ".");
+
+function openApp(t) {
+    const dom = new JSDOM(fs.readFileSync(path.join(root, "index.html"), "utf8"), {
+        url: "http://localhost/#/",
+        runScripts: "outside-only",
+    });
+    const { window } = dom;
+    const document = window.document;
+    const errors = [];
+    window.addEventListener("error", (event) => errors.push(event.error));
+    t.after(() => {
+        window.close();
+        assert.deepEqual(errors, [], "the application should not raise browser errors");
+    });
+
+    // Read local assets without a server or external network requests.
+    for (const link of document.querySelectorAll('link[rel="stylesheet"]')) {
+        const style = document.createElement("style");
+        style.textContent = fs.readFileSync(path.join(root, link.getAttribute("href")), "utf8");
+        document.head.appendChild(style);
+    }
+    for (const script of document.querySelectorAll("script[src]")) {
+        const source = script.getAttribute("src");
+        if (path.basename(source) !== "base.js")
+            window.eval(fs.readFileSync(path.join(root, source), "utf8"));
+    }
+    window.dispatchEvent(new window.Event("load"));
+
+    const find = (selector) => document.querySelector(selector);
+    const item = (id, selector) => find(`.todo-list [data-id="${id}"] ${selector}`);
+    const storage = new window.app.Store("javascript-es5");
+    const todos = () => {
+        let result;
+        storage.findAll((data) => { result = JSON.parse(JSON.stringify(data)); });
+        return result;
+    };
+    return {
+        window, find, item, storage, todos,
+        add(title) {
+            find(".new-todo").value = title;
+            find(".new-todo").dispatchEvent(new window.Event("change", { bubbles: true }));
+            return todos().at(-1)?.id;
+        },
+        toggle(id) { item(id, ".toggle").click(); },
+        remove(id) { item(id, ".destroy").click(); },
+        edit(id, title, cancel = false) {
+            item(id, "label").dispatchEvent(new window.MouseEvent("dblclick", { bubbles: true }));
+            const input = item(id, ".edit");
+            input.value = title;
+            input.dispatchEvent(new window.KeyboardEvent(cancel ? "keyup" : "keypress", {
+                bubbles: true,
+                keyCode: cancel ? 27 : 13,
+            }));
+        },
+        clear() { find(".clear-completed").click(); },
+        undo() { find(".undo-clear-completed").click(); },
+        filter(route) {
+            window.history.replaceState(null, "", "#/" + route);
+            window.dispatchEvent(new window.HashChangeEvent("hashchange"));
+        },
+        rendered() {
+            return Array.from(document.querySelectorAll(".todo-list li"), (li) => ({
+                id: Number(li.dataset.id),
+                title: li.querySelector("label").textContent,
+                completed: li.querySelector(".toggle").checked,
+            }));
+        },
+        available() {
+            const button = find(".undo-clear-completed");
+            assert.ok(button, "the Undo clear completed button exists");
+            assert.equal(button.textContent.trim(), "Undo clear completed");
+            if (button.disabled)
+                return false;
+            for (let element = button; element; element = element.parentElement) {
+                if (element.hidden || window.getComputedStyle(element).display === "none")
+                    return false;
+            }
+            return true;
+        },
+    };
+}
+
+test("undo starts unavailable and clearing an empty list is harmless", (t) => {
+    const app = openApp(t);
+    assert.equal(app.available(), false);
+    app.clear();
+    app.undo();
+    assert.equal(app.available(), false);
+    assert.deepEqual(app.todos(), []);
+    app.add("   ");
+    assert.deepEqual(app.todos(), []);
+    app.add("  First task  ");
+    assert.equal(app.todos()[0].title, "First task");
+    assert.equal(app.find(".new-todo").value, "");
+    app.clear();
+    assert.equal(app.available(), false);
+    assert.equal(app.find(".todo-count").textContent, "1 item left");
+});
+
+test("undo merges original records and order with later additions, edits, toggles and removals", (t) => {
+    const app = openApp(t);
+    const first = app.add("<first> & \"finished\"");
+    const survivor = app.add("Keep and edit");
+    const middle = app.add("Middle finished");
+    const deleted = app.add("Delete separately");
+    const last = app.add("Last finished");
+    [first, middle, last].forEach((id) => app.toggle(id));
+    const before = app.todos();
+    app.clear();
+    assert.deepEqual(app.todos().map((todo) => todo.id), [survivor, deleted]);
+    app.edit(survivor, "  Saved edit  ");
+    app.toggle(survivor);
+    app.remove(deleted);
+    const added = app.add("New after clear");
+    app.edit(added, "New and edited");
+    const expected = [
+        before[0],
+        { id: survivor, title: "Saved edit", completed: true },
+        before[2],
+        before[4],
+        { id: added, title: "New and edited", completed: false },
+    ];
+    app.undo();
+    assert.deepEqual(app.todos(), expected);
+    assert.deepEqual(app.rendered(), expected);
+    assert.equal(app.find(".todo-count").textContent, "1 item left");
+    assert.equal(app.item(first, "label").children.length, 0, "restored titles remain escaped text");
+    assert.equal(app.available(), false);
+    app.undo();
+    assert.deepEqual(app.todos(), expected, "a second undo cannot duplicate tasks");
+    const next = app.add("Created after undo");
+    assert.ok(next > added, "restoring IDs does not reset ID allocation");
+});
+
+test("undo remains reachable after clearing every item; empty clears keep the pending batch", (t) => {
+    const app = openApp(t);
+    const first = app.add("One");
+    const second = app.add("Two");
+    app.toggle(first);
+    app.toggle(second);
+    const before = app.todos();
+    app.clear();
+    assert.deepEqual(app.todos(), []);
+    assert.deepEqual(app.rendered(), []);
+    assert.equal(app.find(".main").style.display, "none");
+    assert.equal(app.find(".footer").style.display, "none");
+    assert.equal(app.find(".todo-count").textContent, "0 items left");
+    assert.equal(app.available(), true);
+    app.clear();
+    app.clear();
+    assert.equal(app.available(), true);
+    app.undo();
+    assert.deepEqual(app.todos(), before);
+    assert.deepEqual(app.rendered(), before);
+    assert.equal(app.available(), false);
+    assert.equal(app.find(".main").style.display, "block");
+});
+
+test("only the latest nonempty batch can be undone", (t) => {
+    const app = openApp(t);
+    const oldBatch = app.add("First batch");
+    const latestBatch = app.add("Second batch");
+    const active = app.add("Still active");
+    app.toggle(oldBatch);
+    app.clear();
+    app.toggle(latestBatch);
+    app.clear();
+    app.clear();
+    app.undo();
+    assert.deepEqual(app.todos(), [
+        { id: latestBatch, title: "Second batch", completed: true },
+        { id: active, title: "Still active", completed: false },
+    ]);
+    assert.equal(app.available(), false);
+    app.undo();
+    assert.equal(app.todos().some((todo) => todo.id === oldBatch), false);
+});
+
+test("separate deletions stay deleted even when no original survivor remains", (t) => {
+    const app = openApp(t);
+    const removedBefore = app.add("Deleted before clear");
+    const first = app.add("Restore first");
+    const removedAfter = app.add("Deleted after clear");
+    const last = app.add("Restore last");
+    app.remove(removedBefore);
+    app.toggle(first);
+    app.toggle(last);
+    app.clear();
+    app.remove(removedAfter);
+    const added = app.add("New survivor");
+    app.clear();
+    app.undo();
+    assert.deepEqual(app.todos().map((todo) => todo.id), [first, last, added]);
+    assert.deepEqual(app.rendered(), app.todos());
+});
+
+for (const route of ["", "active", "completed"]) {
+    test(`clear and undo honor the ${route || "all"} filter and update counts`, (t) => {
+        const app = openApp(t);
+        const active = app.add("Active");
+        const completed = app.add("Completed");
+        app.toggle(completed);
+        app.filter(route);
+        app.clear();
+        assert.deepEqual(app.rendered().map((todo) => todo.id), route === "completed" ? [] : [active]);
+        assert.equal(app.available(), true);
+        app.undo();
+        const expected = route === "active" ? [active] : route === "completed" ? [completed] : [active, completed];
+        assert.deepEqual(app.rendered().map((todo) => todo.id), expected);
+        assert.equal(app.find(".filters .selected").getAttribute("href"), "#/" + route);
+        assert.equal(app.find(".todo-count").textContent, "1 item left");
+        assert.equal(app.find(".clear-completed").style.display, "block");
+        assert.equal(app.available(), false);
+    });
+}
+
+test("editing, cancelling, empty-title deletion and toggle-all still work after undo", (t) => {
+    const app = openApp(t);
+    const first = app.add("First");
+    const second = app.add("Second");
+    app.find(".toggle-all-label").click();
+    assert.ok(app.todos().every((todo) => todo.completed));
+    app.clear();
+    app.undo();
+    app.find(".toggle-all-label").click();
+    assert.ok(app.todos().every((todo) => !todo.completed));
+    app.edit(first, "Keep original", true);
+    assert.equal(app.todos()[0].title, "First");
+    app.edit(first, "  Updated title  ");
+    assert.equal(app.todos()[0].title, "Updated title");
+    app.edit(second, "   ");
+    assert.deepEqual(app.todos().map((todo) => todo.id), [first]);
+    assert.equal(app.find(".todo-count").textContent, "1 item left");
+    assert.equal(app.available(), false);
+});
+
+test("tasks and undo remain in page memory and are isolated by store name", (t) => {
+    const app = openApp(t);
+    const completed = app.add("Page-only task");
+    app.toggle(completed);
+    app.clear();
+    assert.equal(app.storage.canUndoClearCompleted(), true, "instances of the same store share undo state");
+    const other = new app.window.app.Store("other-list");
+    assert.equal(other.canUndoClearCompleted(), false);
+    assert.equal(app.window.localStorage.length, 0);
+    assert.equal(app.window.sessionStorage.length, 0);
+    const fresh = openApp(t);
+    assert.deepEqual(fresh.todos(), []);
+    assert.equal(fresh.available(), false);
+    assert.equal(app.available(), true, "opening another page leaves this page's undo intact");
+    app.storage.drop(() => {});
+    assert.equal(app.storage.canUndoClearCompleted(), false);
+    app.storage.undoClearCompleted(() => {});
+    assert.deepEqual(app.todos(), [], "dropping a store discards its pending undo");
+});
