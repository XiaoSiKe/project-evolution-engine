+from flask.cli import with_appcontext
 
 
 def get_db():
@@ -39,12 +40,39 @@ def init_db():
 
 
 @click.command("init-db")
+@with_appcontext
 def init_db_command():
     """Clear existing data and create new tables."""
     init_db()
     click.echo("Initialized the database.")
 
 
+def upgrade_db():
+    """Add publication status without replacing existing tables or data."""
+    db = get_db()
+    columns = {column["name"] for column in db.execute("PRAGMA table_info(post)")}
+
+    if not columns:
+        raise click.ClickException(
+            "No post table found. Use init-db to initialize a new database."
+        )
+
+    if "status" not in columns:
+        db.execute(
+            "ALTER TABLE post ADD COLUMN status TEXT NOT NULL"
+            " DEFAULT 'published' CHECK (status IN ('draft', 'published'))"
+        )
+        db.commit()
+
+
+@click.command("upgrade-db")
+@with_appcontext
+def upgrade_db_command():
+    """Upgrade an existing database while preserving its data."""
+    upgrade_db()
+    click.echo("Upgraded the database.")
+
+
