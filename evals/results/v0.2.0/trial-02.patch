+def test_upgrade_db_on_current_database(app, runner):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = 'draft' WHERE id = 1")
+        db.commit()
+        original = tuple(db.execute("SELECT * FROM post WHERE id = 1").fetchone())
+
+    for _ in range(2):
+        result = runner.invoke(args=["upgrade-db"])
+        assert result.exit_code == 0, result.output
+
+    with app.app_context():
+        assert tuple(get_db().execute("SELECT * FROM post WHERE id = 1").fetchone()) == original
