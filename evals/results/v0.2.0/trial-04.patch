 import click
 from flask import current_app
 from flask import g
+from flask.cli import with_appcontext
 
 
 def get_db():
@@ -39,12 +40,41 @@ def init_db():
 
 
 @click.command("init-db")
+@with_appcontext
 def init_db_command():
     """Clear existing data and create new tables."""
     init_db()
     click.echo("Initialized the database.")
 
 
+def upgrade_db():
+    """Add post status to an existing database without replacing any data."""
+    db = get_db()
+    with db:
+        # Lock before checking the schema so concurrent upgrades also see
+        # the column added by an earlier invocation.
+        db.execute("BEGIN IMMEDIATE")
+        columns = db.execute("PRAGMA table_info(post)").fetchall()
+        if not columns:
+            raise click.ClickException(
+                "No post table found. Use init-db only for a new database."
+            )
+
+        if "status" not in {column["name"] for column in columns}:
+            db.execute(
+                "ALTER TABLE post ADD COLUMN status TEXT NOT NULL"
+                " DEFAULT 'published' CHECK (status IN ('draft', 'published'))"
+            )
+
+
+@click.command("upgrade-db")
+@with_appcontext
+def upgrade_db_command():
+    """Upgrade existing tables while keeping their data."""
+    upgrade_db()
+    click.echo("Upgraded the database.")
+
+
 sqlite3.register_converter("timestamp", lambda v: datetime.fromisoformat(v.decode()))
 
 
