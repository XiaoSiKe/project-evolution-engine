new file mode 100644
index 0000000000000000000000000000000000000000..13b2bc9e52557d4477657ee5a275b797b625ac57
--- /dev/null
+++ b/tests/test_status.py
@@ -0,0 +1,176 @@
+import pytest
+
+from flaskr.db import get_db
+
+
+def read_posts(app):
+    with app.app_context():
+        return [dict(row) for row in get_db().execute("SELECT * FROM post ORDER BY id")]
+
+
+@pytest.mark.parametrize("status", (None, "draft", "published"))
+def test_create_status(app, client, auth, status):
+    auth.login()
+    data = {"title": "new status post", "body": "new body"}
+    if status is not None:
+        data["status"] = status
+
+    response = client.post("/create", data=data)
+
+    assert response.status_code == 302
+    assert response.headers["Location"] == "/"
+    post = read_posts(app)[-1]
+    assert post["title"] == data["title"]
+    assert post["body"] == data["body"]
+    assert post["author_id"] == 1
+    assert post["status"] == (status or "published")
+
+
+@pytest.mark.parametrize("initial_status", ("draft", "published"))
+@pytest.mark.parametrize("submitted_status", (None, "draft", "published"))
+def test_update_status(app, client, auth, initial_status, submitted_status):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = ? WHERE id = 1", (initial_status,))
+        db.commit()
+    before = read_posts(app)[0]
+    auth.login()
+    data = {"title": "edited title", "body": ""}
+    if submitted_status is not None:
+        data["status"] = submitted_status
+
+    response = client.post("/1/update", data=data)
+
+    assert response.status_code == 302
+    after = read_posts(app)[0]
+    assert after == {
+        **before,
+        "title": "edited title",
+        "body": "",
+        "status": submitted_status or initial_status,
+    }
+
+
+@pytest.mark.parametrize("path", ("/create", "/1/update"))
+@pytest.mark.parametrize("initial_status", ("draft", "published"))
+@pytest.mark.parametrize("invalid_status", ("", "archived", "Published", "draft "))
+def test_invalid_status_preserves_all_posts(
+    app, client, auth, path, initial_status, invalid_status
+):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = ? WHERE id = 1", (initial_status,))
+        db.commit()
+    before = read_posts(app)
+    auth.login()
+
+    response = client.post(
+        path,
+        data={"title": "must not save", "body": "changed", "status": invalid_status},
+    )
+
+    assert response.status_code == 200
+    assert b"Status must be draft or published." in response.data
+    assert read_posts(app) == before
+
+
+@pytest.mark.parametrize("viewer", (None, 1, 2))
+def test_index_visibility_and_creation_order(app, client, viewer):
+    posts = [
+        (1, "draft", "first author draft", "private body one", "2020-01-03"),
+        (2, "published", "second author public", "public body two", "2020-01-02"),
+        (2, "draft", "second author draft", "private body two", "2020-01-04"),
+        (1, "published", "first author public", "public body one", "2020-01-01"),
+    ]
+    with app.app_context():
+        db = get_db()
+        db.executemany(
+            "INSERT INTO post (author_id, status, title, body, created)"
+            " VALUES (?, ?, ?, ?, ?)",
+            posts,
+        )
+        db.commit()
+    if viewer is not None:
+        with client.session_transaction() as session:
+            session["user_id"] = viewer
+
+    response = client.get("/")
+
+    assert response.status_code == 200
+    visible = []
+    for post in read_posts(app):
+        title = post["title"].encode()
+        body = post["body"].encode()
+        edit_link = f'href="/{post["id"]}/update"'.encode()
+        if post["status"] == "published" or post["author_id"] == viewer:
+            assert title in response.data
+            assert body in response.data
+            assert (edit_link in response.data) == (post["author_id"] == viewer)
+            visible.append(post)
+        else:
+            assert title not in response.data
+            assert body not in response.data
+            assert edit_link not in response.data
+
+    visible.sort(key=lambda post: post["created"], reverse=True)
+    positions = [response.data.index(post["title"].encode()) for post in visible]
+    assert positions == sorted(positions)
+    draft_count = sum(post["status"] == "draft" for post in visible)
+    assert response.data.count(b'<span class="status">Draft</span>') == draft_count
+
+
+def test_draft_author_permissions_and_delete(app, client, auth):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = 'draft', author_id = 2 WHERE id = 1")
+        db.commit()
+    before = read_posts(app)
+    auth.login()
+
+    assert client.get("/1/update").status_code == 403
+    assert client.post(
+        "/1/update", data={"title": "stolen", "body": "", "status": "published"}
+    ).status_code == 403
+    assert client.post("/1/delete").status_code == 403
+    assert read_posts(app) == before
+
+    auth.logout()
+    assert client.get("/1/update").headers["Location"] == "/auth/login"
+    assert client.post("/1/delete").headers["Location"] == "/auth/login"
+    with client.session_transaction() as session:
+        session["user_id"] = 2
+    assert b"(Draft)" in client.get("/1/update").data
+    assert client.post("/1/delete").status_code == 302
+    assert read_posts(app) == []
+
+
+@pytest.mark.parametrize("status", ("draft", "published"))
+def test_status_form_selection(app, client, auth, status):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = ? WHERE id = 1", (status,))
+        db.commit()
+    auth.login()
+    create = client.get("/create")
+    update = client.get("/1/update")
+
+    for response in (create, update):
+        assert b'<label for="status">Status</label>' in response.data
+        assert b'<select name="status" id="status" required>' in response.data
+        assert b'value="draft"' in response.data
+        assert b'value="published"' in response.data
+    assert b'<option value="published" selected>' in create.data
+    assert f'<option value="{status}" selected>'.encode() in update.data
+
+
+@pytest.mark.parametrize("path", ("/create", "/1/update"))
+@pytest.mark.parametrize("status", ("draft", "published"))
+def test_title_validation_keeps_submitted_status(app, client, auth, path, status):
+    before = read_posts(app)
+    auth.login()
+    response = client.post(path, data={"title": "", "body": "", "status": status})
+
+    assert b"Title is required." in response.data
+    assert f'<option value="{status}" selected>'.encode() in response.data
+    assert b'<textarea name="body" id="body"></textarea>' in response.data
+    assert read_posts(app) == before
diff --git a/tests/test_upgrade.py b/tests/test_upgrade.py
