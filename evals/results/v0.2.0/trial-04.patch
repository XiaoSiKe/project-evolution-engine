+def test_legacy_upgrade_login_edit_and_publish_flow(legacy_app):
+    result = legacy_app.test_cli_runner().invoke(args=["upgrade-db"])
+    assert result.exit_code == 0, result.output
+    client = legacy_app.test_client()
+    assert b"test title" in client.get("/").data
+    login = client.post("/auth/login", data={"username": "test", "password": "test"})
+    assert login.status_code == 302
+
+    edit = client.post("/1/update", data={"title": "old client edit", "body": "retained"})
+    assert edit.status_code == 302
+    assert client.post(
+        "/create", data={"title": "private post", "body": "private text", "status": "draft"}
+    ).status_code == 302
+    author_home = client.get("/").data
+    assert b"private post" in author_home
+    assert b"Draft" in author_home
+    client.get("/auth/logout")
+    public_home = client.get("/").data
+    assert b"old client edit" in public_home
+    assert b"private post" not in public_home
+    assert b"private text" not in public_home
+
+    client.post("/auth/login", data={"username": "test", "password": "test"})
+    assert client.post(
+        "/100/update", data={"title": "private post", "body": "now public", "status": "published"}
+    ).status_code == 302
+    client.get("/auth/logout")
+    assert b"now public" in client.get("/").data
