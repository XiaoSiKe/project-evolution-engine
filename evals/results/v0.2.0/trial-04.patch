index 0000000000000000000000000000000000000000..83588f1c732c89146023755b539c70b6534edf8f
--- /dev/null
+++ b/tests/test_upgrade.py
@@ -0,0 +1,216 @@
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from flaskr import create_app
+from flaskr.db import get_db
+
+
+LEGACY_SCHEMA = """
+CREATE TABLE user (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  username TEXT UNIQUE NOT NULL,
+  password TEXT NOT NULL
+);
+CREATE TABLE post (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  author_id INTEGER NOT NULL,
+  created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  title TEXT NOT NULL,
+  body TEXT NOT NULL,
+  FOREIGN KEY (author_id) REFERENCES user (id)
+);
+"""
+
+
+@pytest.fixture
+def legacy_app(tmp_path):
+    app = create_app({"TESTING": True, "DATABASE": str(tmp_path / "legacy.sqlite")})
+    with app.app_context():
+        db = get_db()
+        db.executescript(LEGACY_SCHEMA)
+        db.executescript(Path(__file__).with_name("data.sql").read_text())
+        db.executescript(
+            """
+            INSERT INTO post (id, author_id, created, title, body)
+              VALUES (9, 2, '2021-06-01 12:34:56', '旧文章', '保留完整内容');
+            INSERT INTO post (id, author_id, title, body)
+              VALUES (99, 1, 'deleted post', '');
+            DELETE FROM post WHERE id = 99;
+            CREATE TABLE audit (post_id INTEGER, title TEXT);
+            INSERT INTO audit VALUES (100, 'existing audit record');
+            CREATE INDEX post_created_index ON post (created);
+            CREATE TRIGGER post_title_audit AFTER UPDATE OF title ON post
+              BEGIN
+                INSERT INTO audit (post_id, title) VALUES (NEW.id, NEW.title);
+              END;
+            """
+        )
+    return app
+
+
+def preserved_data(app):
+    with app.app_context():
+        db = get_db()
+        return {
+            "users": [tuple(row) for row in db.execute("SELECT * FROM user ORDER BY id")],
+            "posts": [
+                tuple(row)
+                for row in db.execute(
+                    "SELECT id, author_id, created, title, body FROM post ORDER BY id"
+                )
+            ],
+            "sequences": [
+                tuple(row) for row in db.execute("SELECT * FROM sqlite_sequence ORDER BY name")
+            ],
+            "audit": [tuple(row) for row in db.execute("SELECT * FROM audit")],
+            "other_schema": [
+                tuple(row)
+                for row in db.execute(
+                    "SELECT type, name, tbl_name, sql FROM sqlite_master"
+                    " WHERE name != 'post' ORDER BY type, name"
+                )
+            ],
+        }
+
+
+def test_upgrade_preserves_data_objects_sequences_and_drafts(legacy_app):
+    before = preserved_data(legacy_app)
+    runner = legacy_app.test_cli_runner()
+
+    first = runner.invoke(args=["upgrade-db"])
+
+    assert first.exit_code == 0, first.output
+    assert "Upgraded" in first.output
+    assert preserved_data(legacy_app) == before
+    with legacy_app.app_context():
+        db = get_db()
+        assert [row[0] for row in db.execute("SELECT status FROM post ORDER BY id")] == [
+            "published", "published"
+        ]
+        db.execute("UPDATE post SET status = 'draft' WHERE id = 9")
+        db.commit()
+
+    second = runner.invoke(args=["upgrade-db"])
+
+    assert second.exit_code == 0, second.output
+    assert preserved_data(legacy_app) == before
+    with legacy_app.app_context():
+        db = get_db()
+        assert db.execute("SELECT status FROM post WHERE id = 9").fetchone()[0] == "draft"
+        columns = db.execute("PRAGMA table_info(post)").fetchall()
+        assert sum(row["name"] == "status" for row in columns) == 1
+        new_id = db.execute(
+            "INSERT INTO post (author_id, title, body) VALUES (1, 'after upgrade', '')"
+        ).lastrowid
+        assert new_id == 100
+        assert db.execute("SELECT status FROM post WHERE id = ?", (new_id,)).fetchone()[0] == "published"
+        db.execute("UPDATE post SET title = 'changed title' WHERE id = 1")
+        assert tuple(db.execute("SELECT * FROM audit WHERE post_id = 1").fetchone()) == (
+            1, "changed title"
+        )
+        assert db.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
+
+
+def test_upgrade_fresh_database_preserves_current_status(app, runner):
+    with app.app_context():
+        db = get_db()
+        db.execute("UPDATE post SET status = 'draft' WHERE id = 1")
+        db.commit()
+        before = [tuple(row) for row in db.execute("SELECT * FROM post")]
+
+    for _ in range(2):
+        result = runner.invoke(args=["upgrade-db"])
+        assert result.exit_code == 0, result.output
+
+    with app.app_context():
+        assert [tuple(row) for row in get_db().execute("SELECT * FROM post")] == before
+
+
+def test_init_command_creates_status_schema(tmp_path):
+    app = create_app({"TESTING": True, "DATABASE": str(tmp_path / "new.sqlite")})
+
+    result = app.test_cli_runner().invoke(args=["init-db"])
+
+    assert result.exit_code == 0, result.output
+    with app.app_context():
+        db = get_db()
+        db.execute("INSERT INTO user (username, password) VALUES ('author', 'hash')")
+        db.execute("INSERT INTO post (author_id, title, body) VALUES (1, 'default', '')")
+        db.execute(
+            "INSERT INTO post (author_id, title, body, status)"
+            " VALUES (1, 'private', '', 'draft')"
+        )
+        assert [row[0] for row in db.execute("SELECT status FROM post ORDER BY id")] == [
+            "published", "draft"
+        ]
+
+
+@pytest.mark.parametrize("database_kind", ("fresh", "upgraded"))
+@pytest.mark.parametrize("invalid_status", (None, "", "archived"))
+def test_status_database_constraints(app, legacy_app, database_kind, invalid_status):
+    if database_kind == "upgraded":
+        app = legacy_app
+        result = app.test_cli_runner().invoke(args=["upgrade-db"])
+        assert result.exit_code == 0, result.output
+
+    with app.app_context():
+        db = get_db()
+        before = [tuple(row) for row in db.execute("SELECT * FROM post ORDER BY id")]
+        for sql, values in (
+            (
+                "INSERT INTO post (author_id, title, body, status) VALUES (1, 'invalid', '', ?)",
+                (invalid_status,),
+            ),
+            ("UPDATE post SET status = ? WHERE id = 1", (invalid_status,)),
+        ):
+            with pytest.raises(sqlite3.IntegrityError):
+                db.execute(sql, values)
+            db.rollback()
+        assert [tuple(row) for row in db.execute("SELECT * FROM post ORDER BY id")] == before
+
+
+def test_upgrade_missing_post_table_preserves_unrelated_data(tmp_path):
+    app = create_app({"TESTING": True, "DATABASE": str(tmp_path / "uninitialized.sqlite")})
+    with app.app_context():
+        get_db().executescript("CREATE TABLE notes (body TEXT); INSERT INTO notes VALUES ('keep');")
+
+    result = app.test_cli_runner().invoke(args=["upgrade-db"])
+
+    assert result.exit_code == 1
+    assert "No post table found" in result.output
+    with app.app_context():
+        db = get_db()
+        assert db.execute("SELECT body FROM notes").fetchone()[0] == "keep"
+        assert [row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type = 'table'")] == ["notes"]
+
