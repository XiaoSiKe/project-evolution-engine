         callback.call(this, todos);
     };
 
+    /**
+     * Removes one completed batch and remembers only that batch's contents.
+     * An empty clear leaves the previous undo record available.
+     */
+    Store.prototype.removeCompleted = function (callback) {
+        var data = JSON.parse(MemoryStorage[this._dbName]);
+        var removed = data.todos.filter(function (todo) {
+            return todo.completed === true;
+        });
+
+        if (removed.length > 0) {
+            data.lastClear = {
+                todos: removed,
+                order: data.todos.map(function (todo) { return todo.id; }),
+            };
+            data.todos = data.todos.filter(function (todo) {
+                return todo.completed !== true;
+            });
+            MemoryStorage[this._dbName] = JSON.stringify(data);
+        }
+
+        callback = callback || function () {};
+        callback.call(this, removed);
+    };
+
+    Store.prototype.canUndoClearCompleted = function (callback) {
+        callback = callback || function () {};
+        callback.call(this, !!JSON.parse(MemoryStorage[this._dbName]).lastClear);
+    };
+
+    /**
+     * Merges the last cleared batch into the current list, once. Keep current
+     * edits and omit independently deleted items; new items stay at the end.
+     */
+    Store.prototype.undoClearCompleted = function (callback) {
+        var data = JSON.parse(MemoryStorage[this._dbName]);
+        var lastClear = data.lastClear;
+
+        if (lastClear) {
+            var current = {};
+            var cleared = {};
+            var restored = [];
+
+            data.todos.forEach(function (todo) { current[todo.id] = todo; });
+            lastClear.todos.forEach(function (todo) { cleared[todo.id] = todo; });
+            lastClear.order.forEach(function (id) {
+                if (current[id]) {
+                    restored.push(current[id]);
+                    delete current[id];
+                } else if (cleared[id]) {
+                    restored.push(cleared[id]);
+                }
+            });
+            data.todos.forEach(function (todo) {
+                if (current[todo.id])
+                    restored.push(todo);
+            });
+
+            data.todos = restored;
+            delete data.lastClear;
+            MemoryStorage[this._dbName] = JSON.stringify(data);
+        }
+
+        callback = callback || function () {};
+        callback.call(this, data.todos);
+    };
+
     /**
      * Will drop all storage and start fresh
      *
