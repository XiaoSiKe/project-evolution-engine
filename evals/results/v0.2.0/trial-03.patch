diff --git a/test/dom.test.js b/test/dom.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5164a147e1aa2a5963fdde7108c11b921e71a2af
--- /dev/null
+++ b/test/dom.test.js
@@ -0,0 +1,259 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const { JSDOM, VirtualConsole } = require("jsdom");
+
+const appRoot = path.resolve(__dirname, "..", process.env.TODOMVC_TEST_ROOT || ".");
+
+function page(t) {
+    const errors = [];
+    const virtualConsole = new VirtualConsole();
+    virtualConsole.on("jsdomError", error => errors.push(error.message));
+    const dom = new JSDOM(fs.readFileSync(path.join(appRoot, "index.html"), "utf8"), {
+        url: "http://todomvc.test/#/",
+        runScripts: "outside-only",
+        pretendToBeVisual: true,
+        virtualConsole,
+    });
+    const { window } = dom;
+    const { document } = window;
+    t.after(() => {
+        window.close();
+        assert.deepEqual(errors, [], "application DOM handlers must not throw");
+    });
+
+    // This app must keep its original page-local memory semantics.
+    for (const storage of ["localStorage", "sessionStorage"])
+        Object.defineProperty(window, storage, { get() { throw new Error(`Unexpected ${storage} access`); } });
+
+    // Load the entry point's real assets locally; no server or network is used.
+    for (const link of document.querySelectorAll('link[rel="stylesheet"]')) {
+        const style = document.createElement("style");
+        style.textContent = fs.readFileSync(path.join(appRoot, link.getAttribute("href")), "utf8");
+        document.head.appendChild(style);
+    }
+    for (const script of document.querySelectorAll("script[src]")) {
+        const file = script.getAttribute("src");
+        const source = fs.readFileSync(path.join(appRoot, file), "utf8");
+        // TodoMVC's promotional base.js is not application code and can request remote content.
+        if (path.basename(file) !== "base.js")
+            window.eval(source);
+    }
+    window.dispatchEvent(new window.Event("load"));
+
+    const ui = {
+        window,
+        document,
+        get(selector) {
+            const element = document.querySelector(selector);
+            assert.ok(element, `Missing element: ${selector}`);
+            return element;
+        },
+        stored() {
+            let todos;
+            new window.app.Store("javascript-es5").findAll(data => { todos = JSON.parse(JSON.stringify(data)); });
+            return todos;
+        },
+        rows() {
+            return Array.from(document.querySelectorAll(".todo-list > li"), li => {
+                const completed = li.querySelector(".toggle").checked;
+                assert.equal(li.classList.contains("completed"), completed);
+                return { id: Number(li.dataset.id), title: li.querySelector("label").textContent, completed };
+            });
+        },
+        visible(selector) {
+            for (let element = this.get(selector); element; element = element.parentElement) {
+                const style = window.getComputedStyle(element);
+                if (element.hidden || style.display === "none" || style.visibility === "hidden")
+                    return false;
+            }
+            return true;
+        },
+        add(title) {
+            const input = this.get(".new-todo");
+            input.value = title;
+            input.dispatchEvent(new window.Event("change", { bubbles: true }));
+            return this.stored().at(-1);
+        },
+        toggle(id) {
+            this.get(`li[data-id="${id}"] .toggle`).click();
+        },
+        remove(id) {
+            this.get(`li[data-id="${id}"] .destroy`).click();
+        },
+        edit(id, title, key = "blur") {
+            this.get(`li[data-id="${id}"] label`).dispatchEvent(new window.MouseEvent("dblclick", { bubbles: true }));
+            const input = this.get(`li[data-id="${id}"] .edit`);
+            input.value = title;
+            if (key === "blur")
+                input.blur();
+            else
+                input.dispatchEvent(new window.KeyboardEvent(key === "Escape" ? "keyup" : "keypress", {
+                    key, keyCode: key === "Escape" ? 27 : 13, bubbles: true,
+                }));
+        },
+        async filter(route) {
+            const hash = `#/${route}`;
+            if (window.location.hash !== hash) {
+                const changed = new Promise(resolve => window.addEventListener("hashchange", resolve, { once: true }));
+                this.get(`.filters [href="${hash}"]`).click();
+                await changed;
+            }
+            assert.equal(this.get(".filters .selected").getAttribute("href"), hash);
+        },
+        clear() { this.get(".clear-completed").click(); },
+        undo() { this.get(".undo-clear-completed").click(); },
+        assertUndo(available) {
+            const button = this.get(".undo-clear-completed");
+            assert.equal(button.textContent, "Undo clear completed");
+            assert.equal(this.visible(".undo-clear-completed"), available);
+            assert.equal(button.disabled, !available);
+        },
+    };
+    return ui;
+}
+
+test("the empty-list undo entry restores the batch exactly once and escapes titles", t => {
+    const ui = page(t);
+    ui.assertUndo(false);
+    assert.equal(ui.visible(".main"), false);
+    assert.equal(ui.visible(".footer"), false);
+    ui.add("   ");
+    assert.deepEqual(ui.stored(), []);
+    const original = ui.add('  <img src=x onerror="bad()"> & todo  ');
+    ui.toggle(original.id);
+    const completed = { ...original, completed: true };
+    ui.clear();
+    assert.deepEqual(ui.stored(), []);
+    assert.deepEqual(ui.rows(), []);
+    assert.equal(ui.visible(".main"), false);
+    assert.equal(ui.visible(".footer"), false);
+    ui.assertUndo(true);
+    ui.get(".undo-clear-completed").focus();
+    assert.equal(ui.document.activeElement, ui.get(".undo-clear-completed"));
+    ui.clear(); // Hidden clear invokes the same empty-batch handler without losing history.
+    ui.undo();
+    assert.deepEqual(ui.rows(), [completed]);
+    assert.deepEqual(ui.stored(), [completed]);
+    assert.equal(ui.document.querySelector(".todo-list img"), null);
+    assert.equal(ui.visible(".main"), true);
+    assert.equal(ui.visible(".footer"), true);
+    assert.equal(ui.get(".todo-count").textContent, "0 items left");
+    ui.assertUndo(false);
+    ui.undo();
+    ui.get(".undo-clear-completed").dispatchEvent(new ui.window.Event("click"));
+    assert.deepEqual(ui.stored(), [completed]);
+});
+
+test("undo preserves interleaved DOM edits, toggles, additions and independent removals", t => {
+    const ui = page(t);
+    const before = ui.add("deleted before clear");
+    const first = ui.add("first");
+    const second = ui.add("second");
+    const third = ui.add("third");
+    const fourth = ui.add("fourth");
+    ui.toggle(before.id);
+    ui.remove(before.id);
+    ui.toggle(second.id);
+    ui.toggle(fourth.id);
+    ui.clear();
+    assert.deepEqual(ui.rows(), [first, third]);
+    ui.edit(first.id, "  changed first  ", "Enter");
+    ui.toggle(first.id);
+    ui.remove(third.id);
+    const added = ui.add("added");
+    ui.edit(added.id, "edited addition");
+    const removedAddition = ui.add("removed addition");
+    ui.edit(removedAddition.id, "  ");
+    ui.undo();
+    const expected = [
+        { ...first, title: "changed first", completed: true },
+        { ...second, completed: true },
+        { ...fourth, completed: true },
+        { ...added, title: "edited addition" },
+    ];
+    assert.deepEqual(ui.rows(), expected);
+    assert.deepEqual(ui.stored(), expected);
+    assert.equal(ui.get(".todo-count").textContent, "1 item left");
+    assert.equal(ui.visible(".clear-completed"), true);
+    ui.assertUndo(false);
+    assert.ok(ui.add("unique new ID").id > removedAddition.id);
+});
+
+test("only the latest non-empty DOM clear can be undone", t => {
+    const ui = page(t);
+    const first = ui.add("older clear");
+    const second = ui.add("latest clear");
+    ui.toggle(first.id);
+    ui.clear();
+    ui.clear();
+    ui.assertUndo(true);
+    ui.toggle(second.id);
+    ui.clear();
+    ui.assertUndo(true);
+    ui.undo();
+    assert.deepEqual(ui.rows(), [{ ...second, completed: true }]);
+    assert.deepEqual(ui.stored(), [{ ...second, completed: true }]);
+    ui.assertUndo(false);
+});
+
+for (const route of ["active", "completed"]) {
+    test(`clear and undo preserve the ${route} filter and global active count`, async t => {
+        const ui = page(t);
+        const active = ui.add("active");
+        const first = ui.add("first completed");
+        const second = ui.add("second completed");
+        ui.toggle(first.id);
+        ui.toggle(second.id);
+        await ui.filter(route);
+        ui.clear();
+        assert.deepEqual(ui.rows(), route === "active" ? [active] : []);
+        ui.assertUndo(true);
+        ui.undo();
+        const completed = [{ ...first, completed: true }, { ...second, completed: true }];
+        assert.deepEqual(ui.rows(), route === "active" ? [active] : completed);
+        assert.equal(ui.get(".filters .selected").getAttribute("href"), `#/${route}`);
+        assert.equal(ui.get(".todo-count").textContent, "1 item left");
+        ui.assertUndo(false);
+        await ui.filter("completed");
+        ui.toggle(first.id);
+        assert.deepEqual(ui.rows(), [completed[1]]);
+        assert.equal(ui.get(".todo-count").textContent, "2 items left");
+        await ui.filter("");
+        assert.deepEqual(ui.rows(), [active, first, completed[1]]);
+    });
+}
+
+test("cancel editing, toggle all and blank-title deletion work while undo remains available", t => {
+    const ui = page(t);
+    const completed = ui.add("cleared");
+    const survivor = ui.add("survivor");
+    ui.toggle(completed.id);
+    ui.clear();
+    ui.edit(survivor.id, "discard this draft", "Escape");
+    assert.deepEqual(ui.rows(), [survivor]);
+    ui.get(".toggle-all-label").click();
+    assert.deepEqual(ui.rows(), [{ ...survivor, completed: true }]);
+    assert.equal(ui.get(".todo-count").textContent, "0 items left");
+    ui.get(".toggle-all-label").click();
+    assert.deepEqual(ui.rows(), [survivor]);
+    assert.equal(ui.get(".todo-count").textContent, "1 item left");
+    ui.edit(survivor.id, " ");
+    assert.deepEqual(ui.stored(), []);
+    ui.assertUndo(true);
+    ui.undo();
+    assert.deepEqual(ui.rows(), [{ ...completed, completed: true }]);
+});
+
+test("a fresh page has no todos or undo record and restarts page-local IDs", t => {
+    const firstPage = page(t);
+    const first = firstPage.add("old page");
+    firstPage.toggle(first.id);
+    firstPage.clear();
+    firstPage.assertUndo(true);
+    const freshPage = page(t);
+    assert.deepEqual(freshPage.stored(), []);
+    freshPage.assertUndo(false);
+    assert.equal(freshPage.add("fresh page").id, first.id);
+});
diff --git a/test/model.test.js b/test/model.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..99a33e1f09481282a34aaa18eba209cc6db63cbc
--- /dev/null
+++ b/test/model.test.js
@@ -0,0 +1,147 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+function models() {
+    const context = vm.createContext({ window: {} });
+    for (const file of ["store.js", "model.js"])
+        vm.runInContext(fs.readFileSync(path.join(__dirname, "../src", file), "utf8"), context);
+
+    return function (name = "todos") {
+        const model = new context.window.app.Model(new context.window.app.Store(name));
+        return {
+            model,
+            call(method, ...args) {
+                let result;
+                model[method](...args, function (value) {
+                    result = JSON.parse(JSON.stringify(value));
+                });
+                return result;
+            },
+            add(title, completed = false) {
+                const todo = this.call("create", title)[0];
+                this.call("update", todo.id, { completed });
+                return { ...todo, completed };
+            },
+        };
+    };
+}
+
+test("undo merges original batch IDs and order with current edits, additions and deletions", () => {
+    const list = models()();
+    const singleBefore = list.add("single deletion before clear", true);
+    const first = list.add("first");
+    const second = list.add("<second> & third", true);
+    const third = list.add("third");
+    const fourth = list.add("fourth", true);
+    const fifth = list.add("fifth", true);
+    list.call("remove", singleBefore.id);
+    assert.deepEqual(list.call("removeCompleted"), [second, fourth, fifth]);
+    assert.equal(list.call("canUndoClearCompleted"), true);
+
+    list.call("update", first.id, { title: "edited first", completed: true });
+    list.call("remove", third.id);
+    const newRemoved = list.add("later single deletion");
+    const newKept = list.add("new survivor");
+    list.call("remove", newRemoved.id);
+
+    const expected = [{ ...first, title: "edited first", completed: true }, second, fourth, fifth, newKept];
+    assert.deepEqual(list.call("undoClearCompleted"), expected);
+    assert.deepEqual(list.call("read"), expected);
+    assert.deepEqual(list.call("getCount"), { active: 1, completed: 4, total: 5 });
+    assert.equal(list.call("canUndoClearCompleted"), false);
+    assert.deepEqual(list.call("undoClearCompleted"), expected);
+
+    list.call("remove", second.id);
+    list.call("undoClearCompleted");
+    assert.deepEqual(list.call("read", second.id), []);
+    const next = list.add("next ID");
+    assert.ok(next.id > newKept.id);
+    assert.equal(new Set(list.call("read").map(todo => todo.id)).size, list.call("read").length);
+});
+
+test("empty clears preserve history; each non-empty clear replaces it and undo consumes it", () => {
+    const list = models()();
+    assert.equal(list.call("canUndoClearCompleted"), false);
+    assert.deepEqual(list.call("removeCompleted"), []);
+    assert.deepEqual(list.call("undoClearCompleted"), []);
+    const first = list.add("older batch", true);
+    const second = list.add("newer batch");
+    list.call("removeCompleted");
+    assert.deepEqual(list.call("removeCompleted"), []);
+    assert.equal(list.call("canUndoClearCompleted"), true);
+    list.call("update", second.id, { completed: true });
+    list.call("removeCompleted");
+    assert.deepEqual(list.call("read"), []);
+    assert.deepEqual(list.call("undoClearCompleted"), [{ ...second, completed: true }]);
+    assert.deepEqual(list.call("read", first.id), []);
+    assert.equal(list.call("canUndoClearCompleted"), false);
+    list.call("removeCompleted");
+    assert.deepEqual(list.call("undoClearCompleted"), [{ ...second, completed: true }]);
+});
+
+test("batch order is restored before new tasks when all original survivors were deleted", () => {
+    const list = models()();
+    const first = list.add("anchor before");
+    const second = list.add("completed before", true);
+    const third = list.add("anchor between");
+    const fourth = list.add("completed after", true);
+    list.call("removeCompleted");
+    list.call("remove", first.id);
+    list.call("remove", third.id);
+    const fifth = list.add("new one");
+    const sixth = list.add("new two");
+    assert.deepEqual(list.call("undoClearCompleted"), [second, fourth, fifth, sixth]);
+});
+
+test("undo restores interleaved completed tasks around surviving original tasks", () => {
+    const list = models()();
+    const original = [
+        list.add("completed before", true),
+        list.add("active before"),
+        list.add("completed between", true),
+        list.add("active after"),
+        list.add("completed after", true),
+    ];
+    list.call("removeCompleted");
+    assert.deepEqual(list.call("read"), [original[1], original[3]]);
+    assert.deepEqual(list.call("undoClearCompleted"), original);
+});
+
+test("history shares the named MemoryStorage collection and is discarded by removeAll", () => {
+    const makeModel = models();
+    const list = makeModel("shared");
+    const peer = makeModel("shared");
+    const other = makeModel("separate");
+    const restored = list.add("shared completed", true);
+    const unrelated = other.add("other completed", true);
+    list.call("removeCompleted");
+    assert.equal(peer.call("canUndoClearCompleted"), true);
+    assert.equal(other.call("canUndoClearCompleted"), false);
+    const survivor = peer.add("shared new task");
+    assert.deepEqual(peer.call("undoClearCompleted"), [restored, survivor]);
+    assert.deepEqual(list.call("read"), [restored, survivor]);
+
+    list.call("removeCompleted");
+    peer.call("removeAll");
+    assert.equal(list.call("canUndoClearCompleted"), false);
+    assert.deepEqual(list.call("undoClearCompleted"), []);
+    assert.deepEqual(other.call("read"), [unrelated]);
+});
+
+test("existing create, query, update, count and snapshot isolation behavior is retained", () => {
+    const list = models()();
+    const first = list.add("  trimmed  ");
+    const second = list.add("completed", true);
+    assert.equal(first.title, "trimmed");
+    assert.deepEqual(list.call("read", String(first.id)), [first]);
+    assert.deepEqual(list.call("read", { completed: true }), [second]);
+    list.model.read(data => { data[0].title = "external mutation"; });
+    assert.deepEqual(list.call("read", first.id), [first]);
+    list.call("update", first.id, { title: "changed", completed: true });
+    assert.deepEqual(list.call("getCount"), { active: 0, completed: 2, total: 2 });
+    list.call("remove", second.id);
+    assert.deepEqual(list.call("getCount"), { active: 0, completed: 1, total: 1 });
+});
